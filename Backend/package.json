{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "npm install",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "reset:db": "node scripts/resetDatabase.js",
    "delete:user": "node scripts/deleteUserByEmail.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --test-timeout=60000 --test-force-exit \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit \"tests/integration/**/*.test.js\"",
    "test:watch": "node --test --watch --test-timeout=60000 \"tests/**/*.test.js\"",
    "coverage": "c8 --reporter=text-summary --reporter=lcov --reporter=json-summary --report-dir=coverage --exclude=tests/** --exclude=scripts/debug/** --exclude=coverage/** node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit \"tests/**/*.test.js\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.4.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.10"
  }
}
