{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:components",
    "test:node": "node --test \"tests/**/*.test.js\"",
    "test:node:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:components": "vitest run --pool=threads --maxWorkers=1",
    "test:components:watch": "vitest --pool=threads --maxWorkers=1",
    "test:watch": "npm run test:components:watch",
    "coverage": "npm run coverage:node && npm run coverage:components",
    "coverage:node": "c8 --reporter=text-summary --reporter=lcov --reporter=json-summary --report-dir=coverage/node --exclude=tests/** --exclude=coverage/** node --test \"tests/**/*.test.js\"",
    "coverage:components": "vitest run --pool=threads --maxWorkers=1 --coverage --coverage.reportsDirectory=coverage/components"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@react-google-maps/api": "^2.20.7",
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.11.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.18.0",
    "firebase": "^12.0.0",
    "framer-motion": "^12.23.12",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.536.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.6.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.5.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.11",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^28.1.0",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
